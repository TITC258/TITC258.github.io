  "sections": [
    {
      "no": "01",
      "title": "先说清：化妆品 vs 药品",
      "sub": "判断商品是否涉药的第一标准",
      "blocks": [
        {
          "t": "dual",
          "cards": [
            {
              "icon": "🌸",
              "cls": "cos",
              "title": "化妆品",
              "ps": [
                "用于清洁、美化、提升吸引力或<b>改变外观</b>的物品（或改变外观的组成部分）。",
                "如：护肤霜、香水、口红、彩妆、洗发水、染发剂、除臭剂。"
              ]
            },
            {
              "icon": "💊",
              "cls": "drug",
              "title": "药品",
              "ps": [
                "用于<b>诊断、治愈、缓解、治疗或预防疾病</b>，或影响人体结构/功能的物品。",
                "疾病包括任何伤害、病痛或不利状况，无论是身体还是精神。"
              ]
            }
          ],
          "foot": "高频违规：宣称治疗功效（如抗菌/抗炎、治疗脱发、促进胶原蛋白生成等）、使用医疗术语；使用夸张对比图、生理特征图等暗示性宣传也属于违规情形。"
        }
      ],
      "updated": "2026-10-15"
    },
